+#!/usr/bin/env python3
+"""
+207차 -- "_route_speed_prev anchor" 제안(지선생 의견) 검증 시뮬레이션.
+
+206차 sim_route_205_vego_cap_ab_206.py의 OLD/NEW 두 갈래 구조를 그대로 쓰고,
+세 번째 갈래 C(NEW + anchor)를 추가한다.
+
+  OLD: out_speed = min(raw_col, 150.0)                                  (202차)
+  NEW: out_speed = min(raw_col, max(vEgo_kph, apex_speed), 150.0)       (205차, 현재 코드)
+  C  : NEW과 raw 클리핑은 동일. 다만 boost 무장 순간(apex_delta_kph >
+       ROUTE_APEX_SPEED_DISCONTINUITY_THRESH_KPH)에 한해
+           self.prev = min(self.prev, v_ego_kph)
+       를 추가로 적용 -- "_route_speed_prev가 실제 vEgo보다 높게 부풀어
+       있으면, 새로 감속이 필요해지는 바로 그 프레임에서 실제 차량속도
+       수준으로 눌러준다"는 지선생 제안. 상향(vEgo가 prev보다 큰 경우)은
+       건드리지 않는다(min이므로) -- 173차의 hi=inf 정책과 충돌하지 않게
+       최소 변경으로 한정.
+
+CSV 컬럼 요구: 206차와 동일(t, vEgo, naviPointsActive, routeApexIdx,
+routeApexDist, routeApexSpeed, routeOutSpeed, ccPoseValid,
+positionDtSinceFix, src, desiredSpeed)
+"""
+import csv
+import math
+import sys
+
+ROUTE_MAX_SPEED_KPH = 150.0
+ROUTE_SPEED_LOOP_DT = 0.05
+ROUTE_APEX_SPEED_DISCONTINUITY_THRESH_KPH = 15.0
+ROUTE_VEGO_BOOST_MAX_MSS = 3.0
+ROUTE_POSITION_UNCERTAIN_DT_S = 3.0
+AUTO_NAVI_SPEED_DECEL_RATE = 0.70
+
+
+def load_rows(path):
+    with open(path, newline="") as f:
+        return list(csv.DictReader(f))
+
+
+def f(row, key, default=0.0):
+    v = row.get(key, "")
+    if v in ("", None):
+        return default
+    try:
+        return float(v)
+    except ValueError:
+        return default
+
+
+class Branch:
+    """OLD/NEW/C 각 갈래가 독립적으로 갖는 상태(_route_speed_prev류)."""
+
+    def __init__(self, anchor=False):
+        self.anchor = anchor
+        self.prev = None
+        self.apex_speed_prev = None
+        self.boost_armed = False
+        self.boost_armed_speed = None
+        self.anchor_fired_count = 0  # C 갈래 전용 계측
+
+    def reset(self):
+        self.prev = None
+        self.apex_speed_prev = None
+        self.boost_armed = False
+        self.boost_armed_speed = None
+
+    def step(self, raw_clipped, apex_dist, apex_speed, v_ego_kph, v_ego_ms,
+             cc_pose_valid, position_dt_since_fix):
+        out_speed = raw_clipped
+
+        accel_limit_kmh = AUTO_NAVI_SPEED_DECEL_RATE * 3.6
+        if self.apex_speed_prev is None:
+            pass
+        else:
+            apex_delta_kph = self.apex_speed_prev - apex_speed
+            if apex_delta_kph > ROUTE_APEX_SPEED_DISCONTINUITY_THRESH_KPH:
+                self.boost_armed = True
+                self.boost_armed_speed = apex_speed
+                # [207차 제안, anchor] boost가 새로 무장되는 프레임에서만,
+                # prev가 실제 vEgo보다 높게 부풀어있으면 vEgo 수준으로
+                # 눌러준다. min()이므로 vEgo가 prev보다 큰 쪽은 건드리지
+                # 않음(173차 hi=inf와 충돌 방지).
+                if self.anchor and self.prev is not None and self.prev > v_ego_kph:
+                    self.prev = v_ego_kph
+                    self.anchor_fired_count += 1
+            elif self.boost_armed:
+                if abs(apex_speed - self.boost_armed_speed) > ROUTE_APEX_SPEED_DISCONTINUITY_THRESH_KPH:
+                    self.boost_armed = False
+                    self.boost_armed_speed = None
+        self.apex_speed_prev = apex_speed
+
+        if self.boost_armed and apex_dist > 0:
+            v_target_ms = apex_speed / 3.6
+            if v_ego_ms > v_target_ms:
+                required_decel_mss = (v_ego_ms ** 2 - v_target_ms ** 2) / (2.0 * apex_dist)
+                if required_decel_mss > AUTO_NAVI_SPEED_DECEL_RATE:
+                    boosted_mss = min(required_decel_mss, ROUTE_VEGO_BOOST_MAX_MSS)
+                    accel_limit_kmh = boosted_mss * 3.6
+
+        if self.prev is not None:
+            max_step_kmh = accel_limit_kmh * ROUTE_SPEED_LOOP_DT
+            lo = self.prev - max_step_kmh
+            hi = math.inf
+            if (position_dt_since_fix > ROUTE_POSITION_UNCERTAIN_DT_S
+                    and not cc_pose_valid):
+                hi = self.prev
+            out_speed = min(max(out_speed, lo), hi)
+        self.prev = out_speed
+        return out_speed
+
+
+def simulate(rows):
+    old = Branch()
+    new = Branch()
+    c = Branch(anchor=True)
+    out = []
+    for r in rows:
+        t = f(r, "t")
+        active = r["naviPointsActive"] == "True"
+        v_ego_ms = f(r, "vEgo")
+        v_ego_kph = v_ego_ms * 3.6
+        apex_idx = int(float(r["routeApexIdx"])) if r["routeApexIdx"] not in ("", None) else -1
+        apex_dist = f(r, "routeApexDist")
+        apex_speed = f(r, "routeApexSpeed")
+        raw_col = f(r, "routeOutSpeed", 300.0)
+        cc_pose_valid = r.get("ccPoseValid", "") == "True"
+        position_dt_since_fix = f(r, "positionDtSinceFix")
+
+        if not active:
+            old.reset()
+            new.reset()
+            c.reset()
+            out.append(dict(t=t, active=False, apex_idx=apex_idx, apex_dist=apex_dist,
+                             apex_speed=apex_speed, v_ego_kph=v_ego_kph,
+                             raw_col=raw_col, out_old=None, out_new=None, out_c=None))
+            continue
+
+        raw_old = min(raw_col, ROUTE_MAX_SPEED_KPH)
+        raw_new = min(raw_col, max(v_ego_kph, apex_speed), ROUTE_MAX_SPEED_KPH)
+        raw_c = raw_new  # C는 NEW와 raw 클리핑 동일, prev 처리만 다름
+
+        out_old = old.step(raw_old, apex_dist, apex_speed, v_ego_kph, v_ego_ms,
+                            cc_pose_valid, position_dt_since_fix)
+        out_new = new.step(raw_new, apex_dist, apex_speed, v_ego_kph, v_ego_ms,
+                            cc_pose_valid, position_dt_since_fix)
+        out_c = c.step(raw_c, apex_dist, apex_speed, v_ego_kph, v_ego_ms,
+                        cc_pose_valid, position_dt_since_fix)
+
+        out.append(dict(t=t, active=True, apex_idx=apex_idx, apex_dist=apex_dist,
+                         apex_speed=apex_speed, v_ego_kph=v_ego_kph, raw_col=raw_col,
+                         out_old=out_old, out_new=out_new, out_c=out_c))
+    return out, c.anchor_fired_count
+
+
+def run_synthetic():
+    """지선생이 손으로 든 예시: vEgo=70, 직전 route=150, 100m 앞 apex=30."""
+    print("=" * 70)
+    print("[합성 시나리오] vEgo=70 고정주행, 직전 route_speed_prev=150(가정),")
+    print("100m 앞 apex target=30")
+    print("=" * 70)
+
+    v_ego_kph = 70.0
+    v_ego_ms = v_ego_kph / 3.6
+    apex_speed = 30.0
+    apex_dist0 = 100.0
+
+    for label, anchor in [("NEW(205차, anchor 없음)", False), ("C(NEW+anchor)", True)]:
+        br = Branch(anchor=anchor)
+        # 직전 상태를 인위 주입: prev=150, apex_speed_prev=150 (지선생 시뮬레이션과 동일 가정)
+        br.prev = 150.0
+        br.apex_speed_prev = 150.0
+
+        apex_dist = apex_dist0
+        t = 0.0
+        rows_out = []
+        while apex_dist > 0:
+            raw = calculate_current_speed(apex_dist, apex_speed)
+            raw_clipped = min(raw, max(v_ego_kph, apex_speed), ROUTE_MAX_SPEED_KPH)
+            out = br.step(raw_clipped, apex_dist, apex_speed, v_ego_kph, v_ego_ms,
+                          cc_pose_valid=True, position_dt_since_fix=0.0)
+            rows_out.append((t, apex_dist, raw, out))
+            apex_dist -= v_ego_ms * ROUTE_SPEED_LOOP_DT
+            t += ROUTE_SPEED_LOOP_DT
+
+        print(f"\n--- {label} ---")
+        print(f"{'t':>6} {'dist':>7} {'raw':>7} {'out':>7}")
+        for i, (t_, d_, raw_, out_) in enumerate(rows_out):
+            if i % 20 == 0 or i == len(rows_out) - 1:
+                print(f"{t_:6.2f} {d_:7.1f} {raw_:7.1f} {out_:7.1f}")
+        final = rows_out[-1][3]
+        print(f"apex 도달: 최종 out={final:.1f}, 목표={apex_speed:.1f}, 격차={final - apex_speed:.1f}kph"
+              f"  (anchor 발동 횟수={br.anchor_fired_count})")
+
+
+def calculate_current_speed(left_dist, safe_speed_kph, safe_time=9.0, safe_decel_rate=AUTO_NAVI_SPEED_DECEL_RATE):
+    safe_speed = safe_speed_kph / 3.6
+    safe_dist = safe_speed * safe_time
+    decel_dist = left_dist - safe_dist
+    if decel_dist <= 0:
+        return safe_speed_kph
+    temp = safe_speed ** 2 + 2 * safe_decel_rate * decel_dist
+    speed_mps = math.sqrt(temp) if temp >= 0 else safe_speed
+    return max(safe_speed_kph, min(250, speed_mps * 3.6))
+
+
+def run_real_log(csv_path):
+    print()
+    print("=" * 70)
+    print(f"[실차로그] {csv_path}")
+    print("=" * 70)
+
+    rows = load_rows(csv_path)
+    sim, anchor_fired = simulate(rows)
+    actual = {round(f(r, "t"), 3): (r["src"], f(r, "desiredSpeed")) for r in rows}
+
+    print(f"총 프레임: {len(rows)}, 활성 프레임: {sum(1 for s in sim if s['active'])}")
+    print(f"C 갈래 anchor 발동 횟수(전체 로그): {anchor_fired}")
+    print()
+
+    print("=== 스파이크/고원 구간 t=418.40~423.30 (OLD vs NEW vs C) ===")
+    print(f"{'t':>8} {'idx':>4} {'dist':>6} {'apexSpd':>8} {'vEgo':>6} {'raw':>7} "
+          f"{'OLD':>7} {'NEW':>7} {'C':>7}")
+    for s in sim:
+        if s['active'] and 418.40 <= s['t'] <= 423.30:
+            print(f"{s['t']:8.2f} {s['apex_idx']:4d} {s['apex_dist']:6.1f} {s['apex_speed']:8.1f} "
+                  f"{s['v_ego_kph']:6.1f} {s['raw_col']:7.1f} "
+                  f"{s['out_old']:7.1f} {s['out_new']:7.1f} {s['out_c']:7.1f}")
+    print()
+
+    print("=== 북대전IC 구간 t=450.0~498.0 통계 ===")
+    seg = [s for s in sim if s['active'] and 450.0 <= s['t'] <= 498.0]
+    print(f"프레임 수: {len(seg)}")
+
+    def stats(key):
+        vals = [s[key] for s in seg]
+        return sum(vals) / len(vals), max(vals), min(vals)
+
+    for label, key in [("OLD(150고정)", "out_old"), ("NEW(205차)", "out_new"), ("C(NEW+anchor)", "out_c")]:
+        avg, mx, mn = stats(key)
+        print(f"{label}: 평균={avg:.1f} 최대={mx:.1f} 최소={mn:.1f}")
+    avg_ego, mx_ego, mn_ego = stats("v_ego_kph")
+    print(f"실제 vEgo: 평균={avg_ego:.1f} 최대={mx_ego:.1f} 최소={mn_ego:.1f}")
+    avg_apex, mx_apex, mn_apex = stats("apex_speed")
+    print(f"routeApexSpeed(실제목표): 평균={avg_apex:.1f} 최대={mx_apex:.1f} 최소={mn_apex:.1f}")
+    print()
+
+    would_bind = {"old": 0, "new": 0, "c": 0}
+    n = len(seg)
+    for s in seg:
+        key = round(s['t'], 3)
+        if key in actual:
+            _, actual_spd = actual[key]
+            if s['out_old'] <= actual_spd + 1e-6:
+                would_bind["old"] += 1
+            if s['out_new'] <= actual_spd + 1e-6:
+                would_bind["new"] += 1
+            if s['out_c'] <= actual_spd + 1e-6:
+                would_bind["c"] += 1
+    print(f"would_bind OLD:        {would_bind['old']}/{n} ({100*would_bind['old']/n:.1f}%)")
+    print(f"would_bind NEW(205차): {would_bind['new']}/{n} ({100*would_bind['new']/n:.1f}%)")
+    print(f"would_bind C(anchor):  {would_bind['c']}/{n} ({100*would_bind['c']/n:.1f}%)")
+    print()
+
+    apex_arrival = min(seg, key=lambda s: s['apex_dist'] if s['apex_dist'] > 0 else 1e9)
+    print(f"=== apex 최근접 프레임(t={apex_arrival['t']:.2f}, dist={apex_arrival['apex_dist']:.1f}) ===")
+    print(f"apex_speed(목표)={apex_arrival['apex_speed']:.1f}  vEgo={apex_arrival['v_ego_kph']:.1f}")
+    print(f"OLD={apex_arrival['out_old']:.1f} (격차 {apex_arrival['out_old']-apex_arrival['apex_speed']:.1f})")
+    print(f"NEW={apex_arrival['out_new']:.1f} (격차 {apex_arrival['out_new']-apex_arrival['apex_speed']:.1f})")
+    print(f"C  ={apex_arrival['out_c']:.1f} (격차 {apex_arrival['out_c']-apex_arrival['apex_speed']:.1f})")
+    print()
+
+    spike_seg = [s for s in sim if s['active'] and 418.40 <= s['t'] <= 423.30]
+    max_old = max(s['out_old'] for s in spike_seg)
+    max_new = max(s['out_new'] for s in spike_seg)
+    max_c = max(s['out_c'] for s in spike_seg)
+    print("=== 스파이크 구간(t=418.40~423.30) 내 OLD/NEW/C 최댓값 ===")
